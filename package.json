{
  "name": "@lsongdev/scripts",
  "version": "0.1.0-rc.5",
  "description": "Small, composable ES modules that fill recurring gaps in the Web Platform.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsongdev/scripts.git"
  },
  "homepage": "https://github.com/lsongdev/scripts",
  "sideEffects": false,
  "exports": {
    "./*.js": "./*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "animation/",
    "array/",
    "async/",
    "browser/",
    "crypto/",
    "datetime/",
    "devices/",
    "dom/",
    "elements/",
    "encoding/",
    "files/",
    "graphics/",
    "integrations/",
    "localization/",
    "media/",
    "navigation/",
    "net/",
    "react/",
    "storage/",
    "streams/",
    "text/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "vendor": "node tools/vendor-react.js",
    "prepack": "npm run vendor",
    "check": "npm run vendor && npm run check:static && npm run test:unit && npm run test:browser",
    "check:static": "node tools/validate-repository.js",
    "test": "npm run test:unit",
    "test:unit": "node --test",
    "test:browser": "playwright test --config=tools/playwright.config.js --project=chromium --project=webkit",
    "test:browser:all": "playwright test --config=tools/playwright.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "htm": "3.1.1",
    "preact": "11.0.2",
    "ws": "8.21.3"
  }
}
